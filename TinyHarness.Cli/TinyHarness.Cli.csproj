<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<Version>0.0.1</Version>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- LibraryImport 为经过身份验证的 UAC helper 通道生成本机 stub。 -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- NativeAOT 是必须持续满足的产品约束；SQLite 原生库无法嵌入单文件，
		     发布产物是原生入口加随附 DLL，分发需完整携带。 -->
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<InvariantGlobalization>true</InvariantGlobalization>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

		<AssemblyName>TinyHarness</AssemblyName>
		<RootNamespace>TinyHarness.Cli</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TinyHarness.Core\TinyHarness.Core.csproj" />
	</ItemGroup>

</Project>
