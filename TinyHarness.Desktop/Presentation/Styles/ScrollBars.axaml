<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Codex 风格滚动条：Thumb 与紧凑控件共用胶囊圆角资源。
         Fluent 模板将 Thumb 圆角传给内部 Border，实际圆角受纵向宽度或横向高度约束；
         主题状态样式只改 Thumb 背景，圆角在 pointerover/pressed 等状态下保持一致。
         滚动条的主题色与尺寸资源见 ThemeResources.axaml 的 ThemeDictionaries。 -->
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
    </Style>
</Styles>
