<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 应用内设置面板样式：居中 modal 壳、左导航、通用行、供应商/模型卡与弹层下拉。
         颜色一律引用 ThemeResources.axaml 的语义资源（Popup*/Composer*/Session*/Settings* 系列复用
         既有层级语义，SettingsPanelBackgroundBrush 承担面板独立表面，SettingsEntry* 承担条目卡片）。 -->

    <!-- 遮罩：约 24% 黑，点击关闭由视图 code-behind 承担。 -->
    <Style Selector="Border.settings-mask">
        <Setter Property="Background" Value="#C03B3B3B" />
    </Style>
    <!-- 面板表面：共享面板圆角、柔和投影、裁剪内容。 -->
    <Style Selector="Border.settings-panel">
        <Setter Property="Background" Value="{DynamicResource SettingsPanelBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="BoxShadow" Value="0 18 48 8 #66000000" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- 删除确认消息框：复用侧栏项目删除面板的紧凑尺寸（340×内容高），仅补居中定位。 -->
    <Style Selector="Border.settings-confirm-dialog">
        <Setter Property="Width" Value="340" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="TextBlock.settings-confirm-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settings-confirm-message">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 左导航标题「设置」。 -->
    <Style Selector="TextBlock.settings-nav-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="Margin" Value="0,2,0,6" />
    </Style>
    <!-- 导航行：高 40、Padding 12、胶囊圆角、纯文字；悬停取会话列表层级、选中取弹层选中层级。
         模板与 popup-item 同构（PART_Surface 自绘高亮）。 -->
    <Style Selector="Button.settings-nav-item">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="PART_Surface" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.settings-nav-item:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <Style Selector="Button.settings-nav-item:focus-visible /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <Style Selector="Button.settings-nav-item.selected /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource PopupItemSelectedBrush}" />
    </Style>
    <!-- 设置表单下拉保留宽度约束，触发器外观由全局 dropdown-trigger 提供。 -->
    <Style Selector="Button.settings-select">
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-select:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <Style Selector="Button.settings-select:disabled">
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
    </Style>
    <!-- 外观选择卡：图标+文字纵向排布，选中以气泡强调描边。 -->
    <Style Selector="Button.settings-choice">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <Style Selector="Button.settings-choice.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupItemSelectedBrush}" />
    </Style>
    <Style Selector="Button.settings-choice:disabled">
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
    </Style>
    <!-- 供应商/编辑卡：圆角 12、弹层表面色。 -->
    <Style Selector="Border.settings-card">
        <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.settings-card-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.settings-card-description">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settings-field-label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
    </Style>
    <!-- 设置页表单复用全局文本框外观；密码仍通过 TextBox.PasswordChar 显示。 -->
    <!-- 卡内主按钮（保存）：强调色实底。 -->
    <Style Selector="Button.settings-primary">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.settings-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ComposerSendHoverBrush}" />
    </Style>
    <Style Selector="Button.settings-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
    </Style>
    <Style Selector="Button.settings-primary:disabled">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentMutedBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- 卡内次按钮（取消/编辑）：描边幽灵。 -->
    <Style Selector="Button.settings-secondary">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.settings-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <!-- 危险文字按钮（供应商删除）：常态透明填充（与条目面板同色）并沿用次按钮的描边与内距；
         悬停、按下与键盘聚焦改为危险填充 + 危险红字，描边同色融于填充。 -->
    <Style Selector="Button.settings-danger-text">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style
        Selector="Button.settings-danger-text:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.settings-danger-text:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.settings-danger-text:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupDangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDangerHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <!-- 头部关闭图标按钮：28×28。 -->
    <Style Selector="Button.settings-close-icon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-close-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <!-- 模型条目容器：透明填充（面板底色透出）+ 分割线圆角描边。 -->
    <Style Selector="Border.settings-model-entry">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <!-- 条目折叠按钮：透明图标按钮，悬停取弹层悬停层级。 -->
    <Style Selector="Button.settings-entry-chevron">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-entry-chevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <!-- 条目折叠箭头：ChevronRight 8 viewBox（Path 尺寸=viewBox 规则），展开旋转 90° 朝下。 -->
    <Style Selector="Path.settings-chevron-icon">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="None" />
    </Style>
    <Style Selector="Path.settings-chevron-icon.expanded">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformOperations>rotate(90deg)</TransformOperations>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 「+ 添加」虚线按钮：Rectangle StrokeDashArray 承担虚线（Border 无虚线属性）。 -->
    <Style Selector="Button.settings-add-model">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.settings-add-model:pointerover TextBlock.add-model-caption">
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
    </Style>
    <!-- 行内错误与成功提示。 -->
    <Style Selector="TextBlock.settings-error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 分区副标题。 -->
    <Style Selector="TextBlock.settings-section-intro">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="Border.settings-provider-editor">
        <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.settings-provider-editor TextBox.settings-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ComposerBackgroundBrush}" />
    </Style>
    <Style Selector="Border.settings-help">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPillCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-collapsible">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.settings-collapsible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <!-- 模型选择置于设置壳前方，搜索和操作区固定，仅中间模型列表滚动。 -->
    <Style Selector="Border.settings-model-dialog">
        <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppPanelCornerRadius}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BoxShadow" Value="0 16 48 0 #50000000" />
    </Style>
    <Style Selector="Button.settings-text-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
    </Style>
    <Style Selector="Button.settings-text-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
    </Style>
    <Style Selector="CheckBox.settings-discovered-model">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</Styles>
