<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 会话时间线样式：消息气泡、思考折叠体、历史分页与轻量切换按钮。 -->

    <!-- 会话内容列共享上限：消息时间线与输入区同列——列盒最大 816（内容 760 + 左右
         各 28 呼吸位），窗口更宽时整列在会话区水平居中。各处容器保持「Border 水平
         Padding 28 + 本上限」同构，保证列缘对齐；依赖 Avalonia 布局对 Stretch +
         MaxWidth 的处理（ArrangeCore 中与 Center 同分支，截断后自动居中）。 -->
    <Styles.Resources>
        <x:Double x:Key="ConversationColumnMaxWidth">816</x:Double>
        <!-- 展开思考的阅读上限：与工具结果卡片一致，超长内容在块内滚动。 -->
        <x:Double x:Key="ReasoningBodyMaxHeight">320</x:Double>
    </Styles.Resources>

    <Style Selector="Border.message-bubble">
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.user-bubble">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- 助手回复不用气泡底色，直接融入聊天背景；思考行与工具行同节奏（无包装间距），
         正文块自带呼吸位，因此助手消息不再套 message-bubble。 -->
    <Style Selector="Border.system-bubble">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.reason-body">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- 历史分页按钮：对齐参考 Web 客户端的「加载更早」手动分页。 -->
    <Style Selector="Button.load-older">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.load-older:pointerover">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <!-- 轻量切换按钮：工具卡详情、思考折叠、过程组折叠共用的小号幽灵按钮。 -->
    <Style Selector="Button.tool-toggle">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.tool-toggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <!-- 思考/工具共用折叠行（对齐官方 DisclosureRow）：整行可点，行基色用官方
         label-tertiary、悬停整行（文字+图标）转 label-secondary；负水平 Margin 对齐
         列缘、底部 -4 与相邻行互锁。 -->
    <Style Selector="Button.reason-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="-6,0,-6,-4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.reason-row:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelHoverBrush}" />
    </Style>
    <!-- 悬停/按下只做文字高亮：Fluent 按钮主题会在模板层给 pointerover/pressed
         上底色，须显式钉回透明（同 approval-allow 的处理）。 -->
    <Style Selector="Button.reason-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.reason-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 行首图标盒：图标可能由描边/填充多个部件几何叠成，部件必须共用同一 16 单位
         坐标系（Path 尺寸=viewBox、Stretch=None），再由 RenderTransform 统一做官方
         14/16 缩放（×0.875 + 1px 居中，与官方 svg viewBox 16→14px 逐像素等价）。
         不能用 Stretch=Uniform：它按每个 Path 自己的包围盒独立缩放，混合图标的
         中心点会被放大成实心盘（思考图标）、笔线与文档框会错位（编辑/读取）。 -->
    <Style Selector="Panel.row-leading Path">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0,0" />
        <Setter Property="RenderTransform">
            <MatrixTransform Matrix="0.875,0,0,0.875,1,1" />
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Panel.row-leading Path.row-chev">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.reason-row:pointerover Path.row-icon">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.reason-row:pointerover Path.row-chev-hover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.reason-row.expanded Path.row-icon">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.reason-row.expanded Path.row-chev-hover">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.reason-row.expanded Path.row-chev-open">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 新对话草稿页的工作区下拉：紧贴输入框上缘左对齐的圆角下拉按钮（Codex 风格），
         宽度随内容收缩；弹出列表行复用 PopupMenus 的 popup-item 样式。 -->
    <Style Selector="Button.workspace-picker">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <!-- Fluent 12 的 Button 主题不再默认内容居中（回落到 Stretch）：固定高度下
             不显式设置会让文字贴顶，同 model-picker-button 等固定高文字按钮的处理。 -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.workspace-picker:pointerover">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>

    <!-- 文件改动卡片（已编辑）：对齐 Codex 的中性圆角表面——深色底 #262626、悬停/选中
         #2A2A2A，浅色底 #FFFEFF、悬停/选中 #FBFAFC（见 ThemeResources）。单文件时整卡
         是一个可点按钮；多文件容器头部静态，仅文件行可点，超过 3 行折叠。 -->
    <Style Selector="Border.changes-card">
        <Setter Property="Background" Value="{DynamicResource ChangesCardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="Button.changes-single">
        <Setter Property="Background" Value="{DynamicResource ChangesCardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelHoverBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- Fluent 按钮主题会在模板层给 pointerover/pressed 上底色，须显式钉回卡片色系
         （同 reason-row 的处理）。 -->
    <Style Selector="Button.changes-single:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>
    <Style Selector="Button.changes-single:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardPressedBrush}" />
    </Style>
    <!-- 标题行左侧的编辑徽标底：取悬停色一档，压住图标又不与卡片脱节。 -->
    <Style Selector="Border.changes-badge">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.changes-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.changes-count">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- 增删行数：绿/红独立着色（DiffAdded/DiffDeleted），头部合计与文件行共用。 -->
    <Style Selector="TextBlock.changes-added">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
    </Style>
    <Style Selector="TextBlock.changes-deleted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource DiffDeletedBrush}" />
    </Style>
    <Style Selector="TextBlock.changes-state">
        <Setter Property="Margin" Value="12,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- 单文件卡右侧的「查看变更」：细描边小按钮，与整卡同命令。 -->
    <Style Selector="Button.changes-action">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChangesCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelHoverBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.changes-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>
    <Style Selector="Button.changes-action:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardPressedBrush}" />
    </Style>
    <!-- 多文件容器中的文件行：透明底、悬停/选中卡片悬停色；增删列跨行共享宽度对齐。 -->
    <Style Selector="Button.changes-file">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ToolRowLabelBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.changes-file:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>
    <Style Selector="Button.changes-file:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>
    <Style Selector="Button.changes-toggle">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.changes-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChangesCardHoverBrush}" />
    </Style>

    <!-- 交付声明复用 changes-* 卡片样式；仅保留声明文件可用性状态的文案样式。
         点击仍打开当前文件的应用内视图，不呈现历史 diff。 -->
    <Style Selector="TextBlock.deliverables-state">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.deliverables-state.error">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>

    <!-- Session 右侧单文件 diff 面板。 -->
    <Style Selector="Border.diff-panel">
        <Setter Property="Background" Value="{DynamicResource ChatBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Button.diff-close">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.diff-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.diff-status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- 数据来源标注（本轮差异 / 历史片段 / 当前内容 / 不可用）：比普通状态行更醒目。 -->
    <Style Selector="TextBlock.diff-source">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 历史编辑片段块的头部行与容器边框。 -->
    <Style Selector="TextBlock.diff-fragment-header">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Border.diff-fragment-box">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <!-- 当前文件内容的只读展示：等宽、无边框融入面板背景。 -->
    <Style Selector="TextBox.diff-content">
        <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource ChatBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.diff-open-external">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.diff-open-external:pointerover">
        <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
    </Style>
</Styles>
