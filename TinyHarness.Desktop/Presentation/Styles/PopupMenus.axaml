<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 通用弹层菜单视觉基础：模型选择、分组/排序方式、推理等级等 Flyout 共用。
         颜色一律引用 ThemeResources.axaml 的 Popup* 语义资源；
         行交互沿用 Sidebar 的「Button + 自定义模板 + PART_Surface + Classes.selected」模式，
         不另建控件或状态体系。 -->

    <!-- 弹层最外层面板：对齐 DSH 当前弹层形态（深色 #353638 / 浅色纯白的大圆角面板），
         不加描边；内边距 6 让内部行的高亮圆角不贴到面板边缘。 -->
    <Style Selector="Border.popup-surface">
        <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <!-- 分区标题（如提供方名、分组方式）：弱化说明文字，不是可点击项。
         视觉接近 Typography.caption 但语义不同，弹层配色调整不应波及正文说明文字。 -->
    <Style Selector="TextBlock.popup-section">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="Margin" Value="10,8,10,2" />
    </Style>
    <!-- 可选择行（popup-item）与「名称 + 当前值 + chevron」导航行（popup-navigation）
         共用同一套行几何与模板：高 34、圆角 8、横向 Stretch、PART_Surface 自绘高亮，
         与 Sidebar 行同构（Fluent 12 下按钮默认不再横向撑满，需显式 Stretch）。
         内容布局（勾选位、当前值、chevron）由各 View 自行组合；
         导航行没有选中语义，selected 类只对 popup-item 生效。 -->
    <Style Selector="Button.popup-item, Button.popup-navigation">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="PART_Surface" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <!-- 自定义模板的 ContentPresenter 必须显式携带按钮内容，
                             缺省绑定会把行内文字整体吞掉（只剩固定尺寸元素）。 -->
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 状态样式声明顺序即优先级：悬停与键盘焦点在前、选中（.selected）最后，
         保证行被悬停或聚焦时选中态不被覆盖（与 Sidebar 行同一约定）。 -->
    <Style
        Selector="Button.popup-item:pointerover /template/ Border#PART_Surface,
                     Button.popup-navigation:pointerover /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <Style
        Selector="Button.popup-item:focus-visible /template/ Border#PART_Surface,
                     Button.popup-navigation:focus-visible /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource PopupItemHoverBrush}" />
    </Style>
    <Style Selector="Button.popup-item.selected /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource PopupItemSelectedBrush}" />
    </Style>
    <!-- 危险菜单项（删除工作区）：文字与图标取错误红，悬停/聚焦用红调弱底
         （PopupDangerHoverBrush），其余几何与 popup-item 完全一致。 -->
    <Style Selector="Button.popup-item-danger">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style
        Selector="Button.popup-item-danger:pointerover /template/ Border#PART_Surface,
                     Button.popup-item-danger:focus-visible /template/ Border#PART_Surface">
        <Setter Property="Background" Value="{DynamicResource PopupDangerHoverBrush}" />
    </Style>
    <!-- 弹窗内危险动作按钮（删除工作区）：描边幽灵 + 红字，对齐 DSH deleteAction
         （variant 仍是 outline，红色只落在文字）；其余同 approval-reject 几何。 -->
    <Style Selector="Button.popup-danger-action">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.popup-danger-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PopupDangerHoverBrush}" />
    </Style>
    <!-- 弹窗内单行输入框（重命名工作区）：细描边圆角融入弹层面板，
         聚焦换强调描边；Fluent 状态底色画在模板 Border#PART_BorderElement 上，
         仅需覆盖描边，底色保持面板同色。 -->
    <Style Selector="TextBox.popup-input">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="Transparent" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PopupForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.popup-input /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style
        Selector="TextBox.popup-input:pointerover /template/ Border#PART_BorderElement,
                     TextBox.popup-input:focus /template/ Border#PART_BorderElement,
                     TextBox.popup-input:focus-visible /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- 弹窗内错误提示：弱化卡片上的错误红说明文字。 -->
    <Style Selector="TextBlock.popup-error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <!-- 分区分隔线：非常弱的 1px 灰线；左右 inset 与行内边距对齐，不与高亮圆角相接。 -->
    <Style Selector="Border.popup-divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PopupDividerBrush}" />
        <Setter Property="Margin" Value="10,6" />
    </Style>
    <!-- 下拉内搜索框：行几何由使用处的 Grid 承担（与工作区行同构），本样式只负责
         融入弹层面板的无边框效果——Fluent 把状态底色与描边画在模板部件
         Border#PART_BorderElement 上，须逐状态覆盖为透明（同 Composer.axaml 的
         composer-input 注释）；文本选中高亮按约定关闭（选区全透明）。 -->
    <Style Selector="TextBox.popup-search">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <!-- TextBox 内部 TextPresenter 默认不居中，文字在控件盒内偏上；
             显式居中才能与左侧图标同中线。 -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PopupForegroundBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="Transparent" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PopupForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.popup-search /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style
        Selector="TextBox.popup-search:pointerover /template/ Border#PART_BorderElement,
                     TextBox.popup-search:focus /template/ Border#PART_BorderElement,
                     TextBox.popup-search:focus-visible /template/ Border#PART_BorderElement,
                     TextBox.popup-search:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 导航行右侧的当前值文字：弱化色；MaxWidth 约束 Auto 列宽度并配合截断，
         避免超长模型名把「名称 + 当前值 + chevron」行撑破弹层。 -->
    <Style Selector="TextBlock.popup-value">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="MaxWidth" Value="150" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 「› / ‹」导航指示：弱化色小字，仅承担视觉提示。 -->
    <Style Selector="TextBlock.popup-chevron">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 行尾勾选标记：继承行前景色，仅留出与行文字的间距。 -->
    <Style Selector="TextBlock.popup-check">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="8,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 行尾勾选图标：DSH Menu 的 IconCheckOutlineRegular（16px、1px 描边），
         替代文本「✓」；几何见使用处的 Path 数据。 -->
    <Style Selector="Path.popup-check">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="8,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="None" />
    </Style>
    <Style Selector="Button.popup-item:disabled, Button.popup-navigation:disabled">
        <Setter Property="Foreground" Value="{DynamicResource PopupMutedForegroundBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
</Styles>
