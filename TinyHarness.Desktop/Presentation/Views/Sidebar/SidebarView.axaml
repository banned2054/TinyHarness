<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             xmlns:sidebar="using:TinyHarness.Desktop.Presentation.Views.Sidebar"
             x:Class="TinyHarness.Desktop.Presentation.Views.Sidebar.SidebarView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="280">
    <UserControl.Styles>
        <Style Selector="Ellipse.session-spinner-dot">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-0.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-1.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-2.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-3.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-4.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-5.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-6.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.session-spinner-dot.dot-7.running">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Delay="0:0:0.7" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <!-- 侧栏内容视图：拖拽调宽等窗口级布局由 MainWindow 统一协调（见 MainWindow.axaml.cs），
         宽度上限经 SetSurfaceMaxWidth 与外层 Grid 列同步。 -->
    <Border x:Name="Surface"
            MinWidth="240" MaxWidth="480"
            Background="{DynamicResource SidebarBackgroundBrush}" Padding="12,16,12,12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- 头部：应用名标题行。 -->
            <TextBlock Text="TinyHarness" Classes="heading" HorizontalAlignment="Center" />

            <!-- 顶部「新对话」：DSH newSession 形态——左侧 16px 气泡加号图标，
                 图标与文字间距 6，实底按钮样式见 Button.new-session；
                 选中空白页期间以 current 类保持激活，提供可辨认状态。 -->
            <Button Grid.Row="1"
                    Margin="0,24,0,10"
                    Classes="new-session"
                    Classes.current="{Binding IsNewConversationSelected}"
                    AutomationProperties.Name="新对话"
                    Command="{Binding NewSessionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="16" Height="16"
                          Data="{StaticResource Icon.NewChatOutlineMedium}"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="新对话" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 头部行：列表设置与添加项目入口。 -->
            <Grid Grid.Row="2" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="1" ColumnDefinitions="28,28,28">
                    <Button Grid.Column="0" Classes="sidebar-icon"
                            AutomationProperties.Name="{Binding ArchiveViewButtonName}"
                            ToolTip.Tip="{Binding ArchiveViewButtonName}"
                            Command="{Binding ToggleArchiveViewCommand}">
                        <Path Width="16" Height="16"
                              Data="{StaticResource Icon.ArchiveOutlineRegular}"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="SidebarSettingsButton" Grid.Column="1" Classes="sidebar-icon"
                            IsEnabled="{Binding SidebarPreferencesReady}"
                            AutomationProperties.Name="列表设置"
                            ToolTip.Tip="列表设置"
                            Command="{Binding ToggleSidebarSettingsMenuCommand}">
                        <Path Width="16" Height="16"
                              Data="{StaticResource Icon.SlidersTwoOutlineRegular}"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2"
                              StrokeLineCap="Round" />
                    </Button>
                    <Button Grid.Column="2" Classes="sidebar-icon"
                            IsEnabled="{Binding SidebarPreferencesReady}"
                            AutomationProperties.Name="添加项目"
                            ToolTip.Tip="添加项目"
                            Click="OnOpenProjectClick">
                        <Panel>
                            <Path Width="16" Height="16"
                                  Data="{StaticResource Icon.ProjectAddFolderFill}"
                                  Fill="{DynamicResource TextMutedBrush}" />
                            <Path Width="16" Height="16"
                                  Data="{StaticResource Icon.ProjectAddPlusStroke}"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1"
                                  StrokeLineCap="Round" />
                        </Panel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ListBox 的滚动视口驱动虚拟化，只创建可见行；行按钮继续负责选择与键盘操作。 -->
            <ListBox x:Name="SessionList" Grid.Row="3" Classes="session-list"
                     ItemsSource="{Binding SidebarRows}"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,-12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.DataTemplates>
                    <DataTemplate x:DataType="vm:SidebarCategoryViewModel">
                        <Grid>
                            <Button Classes="sidebar-category-toggle"
                                    IsVisible="{Binding CanCollapse}"
                                    AutomationProperties.Name="{Binding AccessibilityName}"
                                    Command="{Binding $parent[sidebar:SidebarView].DataContext.ToggleSidebarCategoryCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sidebar-category-title" Text="{Binding Title}" />
                                    <Path Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                          Data="{StaticResource Icon.ChevronRight}"
                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          IsVisible="{Binding !IsExpanded}" />
                                    <Path Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center"
                                          Data="{StaticResource Icon.ChevronDown}"
                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          IsVisible="{Binding IsExpanded}" />
                                </Grid>
                            </Button>
                            <TextBlock Classes="sidebar-category-title" Text="{Binding Title}"
                                       Margin="8,12,8,3"
                                       IsVisible="{Binding !CanCollapse}" />
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:ProjectSessionsMoreViewModel">
                        <Button Classes="session-row"
                                Content="展开显示"
                                Foreground="{DynamicResource TextMutedBrush}"
                                AutomationProperties.Name="展开显示"
                                Command="{Binding $parent[sidebar:SidebarView].DataContext.ShowMoreSessionsCommand}"
                                CommandParameter="{Binding Project}" />
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:ProjectViewModel">
                        <!-- 项目组头行：右侧只显示三点菜单与项目内新会话；置顶和重命名收纳在菜单中。 -->
                        <Border Classes="group-row project-header-row" Classes.current="{Binding IsCurrent}"
                                Classes.menu-open="{Binding IsActionsMenuOpen}"
                                ContextRequested="OnProjectHeaderContextRequested"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnProjectHeaderDragOver"
                                DragDrop.Drop="OnProjectHeaderDrop">
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                <Button Grid.Column="0" Classes="group-header" Margin="0"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding $parent[sidebar:SidebarView].DataContext.ToggleProjectCommand}"
                                        CommandParameter="{Binding}">
                                    <!-- 分组行：项目用文件夹图标，无项目分组用对话图标；箭头控制折叠。 -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
                                          HorizontalAlignment="Stretch">
                                        <Panel Grid.Column="0" Width="8" Height="16" VerticalAlignment="Center">
                                            <Panel VerticalAlignment="Center" Width="8" Height="8">
                                                <Path Data="{StaticResource Icon.ChevronRight}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineCap="Round"
                                                      IsVisible="{Binding !IsExpanded}" />
                                                <Path Data="{StaticResource Icon.ChevronDown}"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeLineCap="Round"
                                                      IsVisible="{Binding IsExpanded}" />
                                            </Panel>
                                        </Panel>
                                        <Path Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center"
                                              Data="{StaticResource Icon.ChatOutlineRegular}"
                                              Fill="{DynamicResource TextMutedBrush}"
                                              IsVisible="{Binding IsNoProjectGroup}" />
                                        <Panel Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsNoProjectGroup}">
                                            <Path Width="16" Height="16"
                                                  IsVisible="{Binding !IsExpanded}"
                                                  Data="{StaticResource Icon.FolderCloseRegular}"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" />
                                            <Panel IsVisible="{Binding IsExpanded}">
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Icon.FolderOpenPlate}"
                                                      Fill="{DynamicResource TextMutedBrush}" Opacity="0.16" />
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Icon.FolderOpenFront}"
                                                      Fill="{DynamicResource TextMutedBrush}" />
                                                <Path Width="16" Height="16"
                                                      Data="{StaticResource Icon.FolderOpenBack}"
                                                      Fill="{DynamicResource TextMutedBrush}" />
                                            </Panel>
                                        </Panel>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding HeaderTip}" />
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" Classes="workspace-actions"
                                            Orientation="Horizontal" Spacing="2"
                                            IsVisible="{Binding CanShowActions}">
                                    <Button x:Name="ProjectActionsButton" Classes="workspace-menu"
                                            AutomationProperties.Name="项目操作"
                                            ToolTip.Tip="项目操作"
                                            Click="OnProjectActionsButtonClick"
                                            PointerPressed="OnProjectActionsPointerPressed"
                                            PointerMoved="OnProjectActionsPointerMoved"
                                            PointerReleased="OnProjectActionsPointerReleased">
                                        <Path Width="16" Height="16"
                                              Data="{StaticResource Icon.DotsHorizontalFill}"
                                              Fill="{DynamicResource TextMutedBrush}" />
                                    </Button>
                                    <Button Classes="workspace-new-session"
                                            AutomationProperties.Name="在此项目内新建对话"
                                            ToolTip.Tip="在此项目内新建对话"
                                            Command="{Binding NewSessionCommand}"
                                            IsVisible="{Binding CanEdit}">
                                        <!-- DSH IconNewChatOutlineMedium：气泡包加号（1.3 描边）。 -->
                                        <Path Width="16" Height="16"
                                              Data="{StaticResource Icon.NewChatOutlineMedium}"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" />
                                    </Button>
                                </StackPanel>
                                <Popup DataContext="{Binding}"
                                       PlacementTarget="{Binding #ProjectActionsButton}"
                                       Placement="BottomEdgeAlignedLeft"
                                       HorizontalOffset="{Binding ActionsMenuHorizontalOffset}"
                                       VerticalOffset="{Binding ActionsMenuVerticalOffset}"
                                       IsOpen="{Binding IsActionsMenuOpen, Mode=TwoWay}"
                                       IsLightDismissEnabled="True">
                                    <Border Classes="popup-surface" Width="184" Padding="4" CornerRadius="16">
                                        <StackPanel>
                                            <Button Classes="popup-item" MinHeight="32" Padding="8,0" Margin="0"
                                                    AutomationProperties.Name="打开项目所在目录"
                                                    Click="OnOpenProjectDirectoryMenuClick">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Path Width="14" Height="14" VerticalAlignment="Center"
                                                          Data="{StaticResource Icon.FolderOpenFront}"
                                                          Stroke="{DynamicResource PopupMutedForegroundBrush}"
                                                          StrokeThickness="1" />
                                                    <TextBlock Grid.Column="1" Text="打开项目所在目录"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="popup-item" MinHeight="32" Padding="8,0" Margin="0"
                                                    AutomationProperties.Name="{Binding PinActionName}"
                                                    Click="OnToggleProjectPinMenuClick"
                                                    IsVisible="{Binding !IsDeleting}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Path Width="14" Height="14" VerticalAlignment="Center"
                                                          Data="{StaticResource Icon.PinOutlineRegular}"
                                                          Stroke="{DynamicResource PopupMutedForegroundBrush}"
                                                          StrokeThickness="1" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PinActionName}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="popup-item" MinHeight="32" Padding="8,0" Margin="0"
                                                    AutomationProperties.Name="重命名项目"
                                                    Click="OnRenameProjectMenuClick"
                                                    IsVisible="{Binding !IsDeleting}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Panel Width="14" Height="14">
                                                        <Path Width="14" Height="14"
                                                              Data="{StaticResource Icon.EditBodyFill}"
                                                              Fill="{DynamicResource PopupMutedForegroundBrush}" />
                                                        <Path Width="14" Height="14"
                                                              Data="{StaticResource Icon.EditPenStroke}"
                                                              Stroke="{DynamicResource PopupMutedForegroundBrush}"
                                                              StrokeThickness="1" />
                                                    </Panel>
                                                    <TextBlock Grid.Column="1" Text="重命名项目"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="popup-item" MinHeight="32" Padding="8,0" Margin="0"
                                                    AutomationProperties.Name="{Binding DeleteActionText}"
                                                    Click="OnProjectDeleteMenuClick">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Path Width="14" Height="14" VerticalAlignment="Center"
                                                          Data="{StaticResource Icon.TrashOutlineRegular}"
                                                          Stroke="{DynamicResource PopupMutedForegroundBrush}"
                                                          StrokeThickness="1" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DeleteActionText}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:SessionViewModel">
                        <!-- 选择按钮铺满整行；归档和置顶按钮叠放在行内，避免嵌套 Button。 -->
                        <Grid Classes="session-row-container"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="OnSessionRowDragOver"
                              DragDrop.Drop="OnSessionRowDrop">
                            <Button x:Name="SessionRowButton" Classes="session-row" Padding="20,0,4,0"
                                    Classes.current="{Binding IsSelected}"
                                    Classes.menu-open="{Binding IsActionsMenuOpen}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{Binding Title}"
                                    Click="OnSessionRowClick"
                                    ContextRequested="OnSessionRowContextRequested"
                                    PointerPressed="OnSessionRowPointerPressed"
                                    PointerMoved="OnSessionRowPointerMoved"
                                    PointerReleased="OnSessionRowPointerReleased">
                                <!-- 标题按剩余宽度截断；右侧依次预留归档按钮、4px 间距和状态/置顶槽。 -->
                                <Grid ColumnDefinitions="20,*,24,4,24" HorizontalAlignment="Stretch">
                                    <!-- 常驻 20px 气泡槽；仅置顶会话显示气泡，标题与项目文件夹标题对齐。 -->
                                    <Panel Grid.Column="0" Width="20" VerticalAlignment="Center">
                                        <Path Width="16" Height="16" HorizontalAlignment="Left"
                                              Data="{StaticResource Icon.ChatOutlineRegular}"
                                              Fill="{DynamicResource TextMutedBrush}"
                                              ToolTip.Tip="已置顶"
                                              IsVisible="{Binding IsPinned}" />
                                    </Panel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding WorkspaceRoot}" />
                                    <Panel Grid.Column="4" Classes="session-status" IsHitTestVisible="False"
                                           Width="24" Height="24"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="14" Height="14" IsVisible="{Binding IsRunning}">
                                            <Ellipse Classes="session-spinner-dot dot-0"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="5.5" Canvas.Top="0"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-1"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="10" Canvas.Top="2"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-2"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="11.5" Canvas.Top="5.5"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-3"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="10" Canvas.Top="9.5"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-4"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="5.5" Canvas.Top="11.5"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-5"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="2" Canvas.Top="9.5"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-6"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="0" Canvas.Top="5.5"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                            <Ellipse Classes="session-spinner-dot dot-7"
                                                     Classes.running="{Binding IsRunning}"
                                                     Canvas.Left="2" Canvas.Top="2"
                                                     Width="2.5" Height="2.5"
                                                     Fill="{DynamicResource SidebarRunningIndicatorBrush}" />
                                        </Canvas>
                                        <Panel IsVisible="{Binding !IsRunning}">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentTextBrush}"
                                                     IsVisible="{Binding HasUnreadCompletion}" />
                                        </Panel>
                                    </Panel>
                                </Grid>
                            </Button>
                            <Button Classes="session-archive-action" IsVisible="{Binding CanArchive}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0"
                                    AutomationProperties.Name="{Binding ArchiveActionName}"
                                    ToolTip.Tip="{Binding ArchiveActionName}"
                                    Command="{Binding $parent[sidebar:SidebarView].DataContext.ToggleSessionArchiveCommand}"
                                    CommandParameter="{Binding}">
                                <Path Width="14" Height="14"
                                      Data="{StaticResource Icon.ArchiveOutlineRegular}"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" />
                            </Button>
                            <Button Classes="session-pin-action" IsVisible="{Binding CanPin}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Classes.pinned="{Binding IsPinned}"
                                    AutomationProperties.Name="{Binding PinActionName}"
                                    ToolTip.Tip="{Binding PinActionName}"
                                    Command="{Binding $parent[sidebar:SidebarView].DataContext.ToggleSessionPinCommand}"
                                    CommandParameter="{Binding}">
                                <Path Width="14" Height="14"
                                      Data="{StaticResource Icon.PinOutlineRegular}"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" />
                            </Button>
                            <Popup DataContext="{Binding}"
                                   PlacementTarget="{Binding #SessionRowButton}"
                                   Placement="BottomEdgeAlignedLeft"
                                   HorizontalOffset="{Binding ActionsMenuHorizontalOffset}"
                                   VerticalOffset="{Binding ActionsMenuVerticalOffset}"
                                   IsOpen="{Binding IsActionsMenuOpen, Mode=TwoWay}"
                                   IsLightDismissEnabled="True">
                                <Border Classes="popup-surface" Width="184" Padding="4" CornerRadius="16">
                                    <Button Classes="popup-item popup-item-danger" MinHeight="32" Padding="8,0"
                                            Margin="0" AutomationProperties.Name="删除会话"
                                            Click="OnSessionDeleteMenuClick">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Path Width="14" Height="14" VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.TrashOutlineRegular}"
                                                  Stroke="{DynamicResource StatusErrorBrush}" StrokeThickness="1" />
                                            <TextBlock Grid.Column="1" Text="删除会话" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </Popup>
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <Popup x:Name="SidebarSettingsPopup"
                   PlacementTarget="{Binding #SidebarSettingsButton}"
                   Placement="BottomEdgeAlignedRight" VerticalOffset="4"
                   IsOpen="{Binding IsSidebarSettingsMenuOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-surface" Width="224" Padding="4" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="分组方式" Classes="popup-section"
                                   FontSize="11" Margin="10,6,10,2" />
                        <Button Classes="popup-item" MinHeight="30" Padding="8,0" Margin="0"
                                AutomationProperties.Name="按项目"
                                Command="{Binding SelectProjectSidebarModeCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Path Width="14" Height="14" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.FolderCloseRegular}"
                                      Stroke="{DynamicResource PopupMutedForegroundBrush}" StrokeThickness="1" />
                                <TextBlock Grid.Column="1" Text="按项目" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check" Width="14" Height="14"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding IsProjectMode}" />
                            </Grid>
                        </Button>
                        <Button Classes="popup-item" MinHeight="30" Padding="8,0" Margin="0"
                                AutomationProperties.Name="单列表"
                                Command="{Binding SelectSessionSidebarModeCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Path Width="14" Height="14" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.FlatListOutlineRegular}"
                                      Stroke="{DynamicResource PopupMutedForegroundBrush}" StrokeThickness="1"
                                      StrokeLineCap="Round" />
                                <TextBlock Grid.Column="1" Text="单列表" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check" Width="14" Height="14"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding !IsProjectMode}" />
                            </Grid>
                        </Button>

                        <Border Height="1" Margin="8,5"
                                Background="{DynamicResource SidebarSettingsDividerBrush}"
                                IsVisible="{Binding IsProjectMode}" />
                        <TextBlock Text="排序方式" Classes="popup-section"
                                   FontSize="11" Margin="10,4,10,2"
                                   IsVisible="{Binding IsProjectMode}" />
                        <Button Classes="popup-item" MinHeight="30" Padding="8,0" Margin="0"
                                IsVisible="{Binding IsProjectMode}"
                                AutomationProperties.Name="手动排序"
                                Command="{Binding SelectManualProjectOrderCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Path Width="14" Height="14" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.ChevronsUpDownOutlineRegular}"
                                      Stroke="{DynamicResource PopupMutedForegroundBrush}" StrokeThickness="1"
                                      StrokeLineCap="Round" />
                                <TextBlock Grid.Column="1" Text="手动排序" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check" Width="14" Height="14"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding IsManualProjectOrder}" />
                            </Grid>
                        </Button>
                        <Button Classes="popup-item" MinHeight="30" Padding="8,0" Margin="0"
                                IsVisible="{Binding IsProjectMode}"
                                AutomationProperties.Name="最近更新"
                                Command="{Binding SelectRecentProjectOrderCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Path Width="14" Height="14" VerticalAlignment="Center"
                                      Data="{StaticResource Icon.ClockOutlineRegular}"
                                      Stroke="{DynamicResource PopupMutedForegroundBrush}" StrokeThickness="1"
                                      StrokeLineCap="Round" />
                                <TextBlock Grid.Column="1" Text="最近更新" VerticalAlignment="Center" />
                                <Path Grid.Column="2" Classes="popup-check" Width="14" Height="14"
                                      Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1"
                                      IsVisible="{Binding !IsManualProjectOrder}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 底部设置入口与新对话共用按钮样式；加载、整理提示和草稿恢复显示在按钮上方。 -->
            <StackPanel Grid.Row="4" Margin="0,16,0,0" Spacing="7">
                <!-- 失败首发草稿的显式恢复入口：用户点击才返回，不抢导航、不占侧栏会话行。 -->
                <Button Content="返回未发送草稿" Command="{Binding ReturnToFailedDraftCommand}"
                        IsVisible="{Binding HasFailedDraft}" />
                <TextBlock Text="正在加载历史…" Classes="caption"
                           IsVisible="{Binding LoadingHistory}" />
                <TextBlock Text="{Binding OrganizeNotice}" Classes="caption" TextWrapping="Wrap"
                           IsVisible="{Binding HasOrganizeNotice}" />
                <Button Classes="new-session" AutomationProperties.Name="设置"
                        Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="16" Height="16"
                              Data="{StaticResource Icon.SettingsOutlineRegular}"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 项目重命名弹窗：预填当前名并全选，Enter 确认、Esc/取消/浅失焦关闭；
                 确认按显示修订号保存，错误留在弹窗内可重试。弹窗实例全局一份（状态在
                 MainWindowViewModel），不随行投影重复创建。 -->
            <Popup x:Name="ProjectRenamePopup"
                   PlacementTarget="{Binding #Surface}" Placement="Center"
                   IsOpen="{Binding IsProjectRenameOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="True">
                <Border Classes="popup-surface" Width="320" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="重命名项目"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PopupForegroundBrush}" />
                        <TextBox x:Name="ProjectRenameInput"
                                 Classes="popup-input"
                                 Text="{Binding ProjectRenameDraftText, Mode=TwoWay}"
                                 AutomationProperties.Name="项目名称" />
                        <TextBlock Classes="popup-error"
                                   Text="{Binding ProjectRenameErrorText}"
                                   IsVisible="{Binding HasProjectRenameError}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="approval-reject" Content="取消"
                                    Command="{Binding CancelProjectRenameCommand}" />
                            <Button Classes="approval-allow" Content="重命名"
                                    Command="{Binding ConfirmProjectRenameCommand}"
                                    IsEnabled="{Binding CanConfirmProjectRename}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="ProjectDeletionPopup"
                   PlacementTarget="{Binding #Surface}" Placement="Center"
                   IsOpen="{Binding IsProjectDeletionOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="False">
                <Border x:Name="ProjectDeletionPanel" Classes="popup-surface" Width="340" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="删除项目"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PopupForegroundBrush}" />
                        <TextBlock Text="{Binding ProjectDeletionTargetName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProjectDeletionPrompt}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="popup-error"
                                   Text="{Binding ProjectDeletionErrorText}"
                                   IsVisible="{Binding HasProjectDeletionError}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="approval-reject" Content="取消"
                                    Command="{Binding CancelProjectDeletionCommand}"
                                    IsEnabled="{Binding !IsProjectDeletionRunning}" />
                            <Button Classes="approval-allow" Content="{Binding ProjectDeletionButtonText}"
                                    Command="{Binding ConfirmProjectDeletionCommand}"
                                    IsEnabled="{Binding CanConfirmProjectDeletion}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding #Surface}" Placement="Center"
                   IsOpen="{Binding IsSessionDeletionOpen, Mode=TwoWay}"
                   IsLightDismissEnabled="False">
                <Border Classes="popup-surface" Width="340" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="删除会话" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PopupForegroundBrush}" />
                        <TextBlock Text="{Binding SessionDeletionTargetName}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SessionDeletionPrompt}" TextWrapping="Wrap" />
                        <TextBlock Classes="popup-error" Text="{Binding SessionDeletionErrorText}"
                                   IsVisible="{Binding HasSessionDeletionError}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="approval-reject" Content="取消"
                                    Command="{Binding CancelSessionDeletionCommand}"
                                    IsEnabled="{Binding !IsSessionDeletionRunning}" />
                            <Button Classes="popup-danger-action" Content="永久删除"
                                    Command="{Binding ConfirmSessionDeletionCommand}"
                                    IsEnabled="{Binding CanConfirmSessionDeletion}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
