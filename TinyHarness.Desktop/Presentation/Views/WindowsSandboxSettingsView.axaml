<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.WindowsSandboxSettingsView"
             x:DataType="vm:WindowsSandboxSettingsViewModel">
    <StackPanel IsVisible="{Binding IsActive}" Margin="0,10,0,0">
        <TextBlock Classes="settings-section-intro" Text="{Binding Intro}" />
        <TextBlock Classes="settings-group-title" Text="执行环境" />
        <Border Classes="settings-group">
            <Border Classes="settings-row last">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="settings-card-title" Text="启用 Windows 沙箱" />
                        <TextBlock Text="显式启用后，workspace 作用域命令在沙箱内执行；组件或路径校验失败会拒绝执行，不回退宿主。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="启用 Windows 沙箱" />
                </Grid>
            </Border>
        </Border>
        <TextBlock Classes="settings-group-title" Text="网络访问" Margin="0,24,0,10" />
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="settings-card-title" Text="沙箱网络策略" VerticalAlignment="Center" />
                        <ComboBox Classes="dropdown" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                  ItemsSource="{Binding NetworkPolicyOptions}"
                                  SelectedItem="{Binding SelectedNetworkPolicy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SandboxNetworkPolicyChoice">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Classes="settings-row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="settings-card-title" Text="允许 TCP 环回" />
                            <TextBlock Text="允许访问宿主本地 TCP 服务；外部网络与 UDP 仍被阻断。"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowTcpLoopback}" VerticalAlignment="Center"
                                      AutomationProperties.Name="允许 TCP 环回" />
                    </Grid>
                </Border>
                <Border Classes="settings-row last">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="settings-card-title" Text="沙箱内代理" />
                                <TextBlock Text="沙箱内命令访问网络时使用的代理方式；代理凭据保存在系统凭据存储，此处不显示。"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                            </StackPanel>
                            <ComboBox Classes="dropdown" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                      ItemsSource="{Binding ProxyModeOptions}"
                                      SelectedItem="{Binding SelectedProxyMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SandboxProxyModeChoice">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <ComboBox Classes="dropdown" IsVisible="{Binding IsNamedProxyMode}" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding SelectedProxy}"
                                  PlaceholderText="选择一个已保存的代理">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetworkProxyChoice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Classes="settings-group-title" Text="目录与环境" Margin="0,24,0,10" />
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="settings-card-title" Text="额外只读根" />
                        <TextBlock Classes="settings-card-description" Text="一行一个绝对路径。" />
                        <TextBox Classes="settings-input" Text="{Binding ReadRootsText}" AcceptsReturn="True"
                                 MinHeight="56" Padding="10,6" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>
                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="settings-card-title" Text="额外写根" />
                        <TextBlock Classes="settings-card-description" Text="一行一个绝对路径。" />
                        <TextBox Classes="settings-input" Text="{Binding WriteRootsText}" AcceptsReturn="True"
                                 MinHeight="56" Padding="10,6" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>
                <Border Classes="settings-row last">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="settings-card-title" Text="附加环境变量" />
                        <TextBlock Classes="settings-card-description" Text="一行一条 KEY=VALUE。" />
                        <TextBox Classes="settings-input" Text="{Binding EnvironmentText}" AcceptsReturn="True"
                                 MinHeight="56" Padding="10,6" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Classes="settings-card-description" Text="{Binding Notice}" Margin="0,12,0,0" />
        <Button Content="重试" Command="{Binding SaveCommand}" Classes="settings-secondary"
                IsVisible="{Binding HasAutoSaveError}"
                HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
