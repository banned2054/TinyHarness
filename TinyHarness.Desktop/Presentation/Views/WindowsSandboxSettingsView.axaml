<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.WindowsSandboxSettingsView"
             x:DataType="vm:WindowsSandboxSettingsViewModel">
    <StackPanel IsVisible="{Binding IsActive}" Spacing="14" Margin="0,10,0,0">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PopupMutedForegroundBrush}" />
        <Border Classes="settings-row" Padding="0,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="启用 Windows 沙箱" FontSize="14" />
                    <TextBlock Text="显式启用后，workspace 作用域命令在沙箱内执行；组件或路径校验失败会拒绝执行，不回退宿主。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                              AutomationProperties.Name="启用 Windows 沙箱" />
            </Grid>
        </Border>
        <Border Classes="settings-row" Padding="0,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="沙箱网络策略" FontSize="14" />
                    <TextBlock Text="受限：每次联网申请都需审批；常设允许：信任沙箱联网，不再逐次询问。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                          ItemsSource="{Binding NetworkPolicyOptions}"
                          SelectedItem="{Binding SelectedNetworkPolicy}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SandboxNetworkPolicyChoice">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
        <Border Classes="settings-row" Padding="0,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="允许 TCP 环回" FontSize="14" />
                    <TextBlock Text="允许访问宿主本地 TCP 服务；外部网络与 UDP 仍被阻断。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowTcpLoopback}" VerticalAlignment="Center"
                              AutomationProperties.Name="允许 TCP 环回" />
            </Grid>
        </Border>
        <Border Classes="settings-row" Padding="0,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="沙箱内代理" FontSize="14" />
                        <TextBlock Text="沙箱内命令访问网络时使用的代理方式；代理凭据保存在系统凭据存储，此处不显示。"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="220" VerticalAlignment="Center"
                              ItemsSource="{Binding ProxyModeOptions}"
                              SelectedItem="{Binding SelectedProxyMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SandboxProxyModeChoice">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <ComboBox IsVisible="{Binding IsNamedProxyMode}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ProxyChoices}" SelectedItem="{Binding SelectedProxy}"
                          PlaceholderText="选择一个已保存的代理">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkProxyChoice">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>
        <StackPanel Spacing="4">
            <TextBlock Text="额外只读根（一行一个绝对路径）" FontSize="14" />
            <TextBox Text="{Binding ReadRootsText}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="额外写根（一行一个绝对路径）" FontSize="14" />
            <TextBox Text="{Binding WriteRootsText}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="附加环境变量（一行一条 KEY=VALUE）" FontSize="14" />
            <TextBox Text="{Binding EnvironmentText}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" />
        <Button Content="保存沙箱设置" Command="{Binding SaveCommand}" Classes="settings-secondary"
                HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
