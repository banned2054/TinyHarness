<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             xmlns:controls="using:TinyHarness.Desktop.Presentation.Controls"
             x:Class="TinyHarness.Desktop.Presentation.Views.Conversation.ModelPickerView"
             x:DataType="vm:SessionViewModel"
             mc:Ignorable="d"
             d:DesignHeight="34" d:DesignWidth="200">
    <!-- 草稿与已建立会话共用菜单结构，支持紧凑滑块、一体面板与经典列表三种交互形态。 -->
    <Panel>
        <Button x:Name="ModelPickerButton"
                Classes="model-picker-button dropdown-trigger"
                Command="{Binding ToggleModelMenuCommand}"
                AutomationProperties.Name="选择模型与推理等级"
                ToolTip.Tip="模型与推理等级">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Text="{Binding ModelPickerLabel}"
                           TextTrimming="CharacterEllipsis" />
                <Path Grid.Column="1"
                      Data="{StaticResource Icon.DropdownChevron}"
                      Width="8" Height="4"
                      Stretch="None"
                      Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.6"
                      VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Popup x:Name="ModelPickerPopup" Classes="dropdown-popup"
               PlacementTarget="{Binding #ModelPickerButton}"
               Placement="Top"
               VerticalOffset="-4"
               IsOpen="{Binding IsModelMenuOpen, Mode=TwoWay}"
               IsLightDismissEnabled="True">
            <Border Classes="popup-surface dropdown-popup" Width="264" MaxHeight="420">
                <Panel>
                    <!-- 形态 1：紧凑滑块卡片（默认）——顶部显示当前强度与可点模型名，底部直接拖动强度滑块。 -->
                    <StackPanel IsVisible="{Binding IsCompactSliderRootPage}" Margin="9,7,9,9" Spacing="2">
                        <TextBlock Text="{Binding EffortSliderDisplayText}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" />
                        <Button Classes="model-card-switcher"
                                Command="{Binding ShowModelsPageCommand}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="切换模型">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding CurrentModelLabel}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200" />
                                <TextBlock Text="›" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="当前运行结束后可切换。"
                                   IsVisible="{Binding !CanChangeModel}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource PopupMutedForegroundBrush}"
                                   FontSize="11" />
                        <controls:EffortSliderControl x:Name="CompactEffortSlider"
                                                      Margin="0,10,0,0"
                                                      OptionCount="{Binding EffortOptionCount}"
                                                      SelectedIndex="{Binding SelectedEffortIndex}"
                                                      IsEnabled="{Binding CanAdjustEffortSlider}"
                                                      TrackBrush="{DynamicResource EffortSliderTrackBrush}"
                                                      FillBrush="{DynamicResource EffortSliderFillBrush}"
                                                      ThumbBrush="{DynamicResource EffortSliderThumbBrush}"
                                                      ThumbBorderBrush="{DynamicResource EffortSliderThumbBorderBrush}"
                                                      MutedThumbBrush="{DynamicResource EffortSliderMutedThumbBrush}"
                                                      TickBrush="{DynamicResource EffortSliderTickBrush}"
                                                      ActiveTickBrush="{DynamicResource EffortSliderActiveTickBrush}"
                                                      AutomationProperties.Name="推理等级滑块" />
                    </StackPanel>

                    <!-- 形态 2：一体面板——上方列出模型列表，底部分隔线下方常驻强度滑块。 -->
                    <StackPanel IsVisible="{Binding IsUnifiedPanelPage}">
                        <TextBlock Text="当前运行结束后可切换。"
                                   IsVisible="{Binding !CanChangeModel}" TextWrapping="Wrap" Margin="10,6"
                                   Foreground="{DynamicResource PopupMutedForegroundBrush}" FontSize="12" />
                        <ScrollViewer MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding ModelGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposerModelGroup">
                                        <StackPanel>
                                            <TextBlock Classes="popup-section" Text="{Binding Name}" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ComposerMenuOption">
                                                        <Button Classes="popup-item"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding SelectCommand}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Label}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="popup-check"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsSelected}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Classes="popup-divider" Margin="8,6" />
                        <StackPanel Margin="9,2,9,7" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="推理等级"
                                           FontSize="12"
                                           Foreground="{DynamicResource PopupMutedForegroundBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EffortSliderDisplayText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PopupForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <controls:EffortSliderControl x:Name="UnifiedEffortSlider"
                                                          OptionCount="{Binding EffortOptionCount}"
                                                          SelectedIndex="{Binding SelectedEffortIndex}"
                                                          IsEnabled="{Binding CanAdjustEffortSlider}"
                                                          TrackBrush="{DynamicResource EffortSliderTrackBrush}"
                                                          FillBrush="{DynamicResource EffortSliderFillBrush}"
                                                          ThumbBrush="{DynamicResource EffortSliderThumbBrush}"
                                                          ThumbBorderBrush="{DynamicResource EffortSliderThumbBorderBrush}"
                                                          MutedThumbBrush="{DynamicResource EffortSliderMutedThumbBrush}"
                                                          TickBrush="{DynamicResource EffortSliderTickBrush}"
                                                          ActiveTickBrush="{DynamicResource EffortSliderActiveTickBrush}"
                                                          AutomationProperties.Name="推理等级滑块" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 形态 3：经典列表——主菜单保留模型与推理等级两级导航。 -->
                    <StackPanel IsVisible="{Binding IsClassicListRootPage}">
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowModelsPageCommand}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="模型" />
                                <TextBlock Grid.Column="1"
                                           Classes="popup-value"
                                           Text="{Binding CurrentModelLabel}" />
                                <TextBlock Grid.Column="2" Classes="popup-chevron" Text="›" />
                            </Grid>
                        </Button>
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowEffortsPageCommand}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="推理等级" />
                                <TextBlock Grid.Column="1"
                                           Classes="popup-value"
                                           Text="{Binding CurrentEffortText}" />
                                <TextBlock Grid.Column="2" Classes="popup-chevron" Text="›" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 模型二级菜单（紧凑滑块与经典列表共用）：提供方作分组标题，当前模型勾选。 -->
                    <ScrollViewer IsVisible="{Binding IsModelsSubPage}" MaxHeight="380">
                        <StackPanel>
                            <Button Classes="popup-navigation"
                                    Command="{Binding ShowModelMenuRootCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="popup-chevron" Text="‹" />
                                    <TextBlock Text="模型" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="当前运行结束后可切换。"
                                       IsVisible="{Binding !CanChangeModel}" TextWrapping="Wrap" Margin="10,6"
                                       Foreground="{DynamicResource PopupMutedForegroundBrush}" FontSize="12" />
                            <ItemsControl ItemsSource="{Binding ModelGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComposerModelGroup">
                                        <StackPanel>
                                            <TextBlock Classes="popup-section" Text="{Binding Name}" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ComposerMenuOption">
                                                        <Button Classes="popup-item"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Command="{Binding SelectCommand}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Label}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Classes="popup-check"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsSelected}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 经典列表的推理等级二级菜单。 -->
                    <StackPanel IsVisible="{Binding IsEffortsSubPage}">
                        <Button Classes="popup-navigation"
                                Command="{Binding ShowModelMenuRootCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="popup-chevron" Text="‹" />
                                <TextBlock Text="推理等级" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding EffortOptions}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComposerMenuOption">
                                    <Button Classes="popup-item"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding SelectCommand}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="popup-check"
                                                       Text="✓"
                                                       IsVisible="{Binding IsSelected}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Panel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
