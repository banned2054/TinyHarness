<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.PermissionSettingsView"
             x:DataType="vm:PermissionSettingsViewModel">
    <StackPanel IsVisible="{Binding IsActive}" Spacing="14" Margin="0,10,0,0">
        <TextBlock Text="选择双审批模式的新会话默认值；已有会话保留自己的模式。"
                   TextWrapping="Wrap" Foreground="{DynamicResource PopupMutedForegroundBrush}" />
        <ItemsControl ItemsSource="{Binding Modes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionModeRow">
                    <Border Classes="settings-row" Padding="0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Label}" FontSize="14" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="新会话默认模式" FontSize="14" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionModeRow">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="AI 审批模型" FontSize="14" />
        <CheckBox Content="使用当前会话的模型（随会话模型切换）" IsChecked="{Binding UseCurrentModel}" />
        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding ReviewerModel}"
                  IsEnabled="{Binding UseFixedModel}" PlaceholderText="选择独立的审批供应商与模型"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ApprovalModelChoice">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="AI 使用独立审核请求，可能产生额外用量。AI 明确升级时才转交人工审批；拒绝或技术失败均保持未执行。"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PopupMutedForegroundBrush}" />
        <Border IsVisible="{Binding ConfigMigrationPending}" Classes="settings-row" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="旧权限配置待确认" FontWeight="SemiBold" />
                <TextBlock Text="普通保存不会解除配置门禁。确认后才会将旧七模式写为双审批配置；旧会话仍需在会话页单独确认迁移。"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding MigrationSummary}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                <TextBlock Text="{Binding MigrationError}" IsVisible="{Binding ConfigMigrationPending}"
                           TextWrapping="Wrap" />
                <Button Content="确认迁移权限配置" Command="{Binding ConfirmMigrationCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <Border IsVisible="{Binding StandingTrustVisible}" Classes="settings-row" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="常设授权（沙箱网络与附加写根）" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StandingTrustSummary}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                <TextBlock Text="{Binding StandingTrustError}" IsVisible="{Binding StandingTrustVisible}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="确认常设授权" Command="{Binding ConfirmStandingTrustCommand}"
                            IsVisible="{Binding StandingTrustPending}" HorizontalAlignment="Left" />
                    <Button Content="撤销常设授权" Command="{Binding RevokeStandingTrustCommand}"
                            IsVisible="{Binding StandingTrustActive}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" />
        <Button Content="保存权限设置" Command="{Binding SaveCommand}" Classes="settings-secondary"
                HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
