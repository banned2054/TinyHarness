<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.PermissionSettingsView"
             x:DataType="vm:PermissionSettingsViewModel">
    <StackPanel>
        <TextBlock Classes="settings-group-title" Text="权限与审核" />
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="settings-card-title" Text="新会话默认模式" VerticalAlignment="Center"
                                       ToolTip.Tip="已有会话保留原模式。" />
                            <ComboBox Grid.Column="1" Classes="dropdown" MinWidth="156"
                                      ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode, Mode=TwoWay}"
                                      AutomationProperties.Name="新会话默认权限模式">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PermissionModeRow">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock Classes="settings-card-description"
                                   Text="沙箱基础操作自动执行，额外权限由人工或 AI 审核。" />
                    </StackPanel>
                </Border>
                <Border Classes="settings-row" Classes.last="{Binding UseCurrentModel}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="settings-card-title" Text="审核使用当前模型" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCurrentModel, Mode=TwoWay}"
                                      AutomationProperties.Name="审核使用当前模型" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="settings-row last" IsVisible="{Binding UseFixedModel}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Classes="settings-card-title" Text="审核使用的模型" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="dropdown" MinWidth="156" MaxWidth="300"
                                  ItemsSource="{Binding Models}" SelectedItem="{Binding ReviewerModel, Mode=TwoWay}"
                                  PlaceholderText="选择供应商 / 模型" HorizontalAlignment="Right"
                                  AutomationProperties.Name="审核使用的模型">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ApprovalModelChoice">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Classes="settings-card-description" Margin="0,10,0,0"
                   Text="AI 审核可能产生额外用量；拒绝或失败时不执行。"
                   ToolTip.Tip="AI 使用独立审核请求，仅明确要求人工介入时转交人工审批。" />

        <TextBlock Classes="settings-group-title" Text="常设授权" Margin="0,24,0,10"
                   IsVisible="{Binding StandingTrustVisible}" />
        <Border IsVisible="{Binding StandingTrustVisible}" Classes="settings-group">
            <Border Classes="settings-row last">
                <StackPanel Spacing="8">
                    <TextBlock Classes="settings-card-title" Text="沙箱网络与附加写根" />
                    <TextBlock Text="{Binding StandingTrustSummary}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                    <TextBlock Classes="settings-error" Text="{Binding StandingTrustError}"
                               IsVisible="{Binding StandingTrustVisible}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="settings-secondary" Content="确认常设授权" Command="{Binding ConfirmStandingTrustCommand}"
                                IsVisible="{Binding StandingTrustPending}" HorizontalAlignment="Left" />
                        <Button Classes="settings-danger-text" Content="撤销常设授权" Command="{Binding RevokeStandingTrustCommand}"
                                IsVisible="{Binding StandingTrustActive}" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <TextBlock Classes="settings-card-description" Text="{Binding Notice}" Margin="0,12,0,0" />
        <Button Content="重试" Command="{Binding SaveCommand}" Classes="settings-secondary"
                IsVisible="{Binding HasAutoSaveError}"
                HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
