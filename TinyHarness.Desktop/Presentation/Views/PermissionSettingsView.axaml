<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.PermissionSettingsView"
             x:DataType="vm:PermissionSettingsViewModel">
    <StackPanel IsVisible="{Binding IsActive}" Spacing="14" Margin="0,10,0,0">
        <TextBlock Text="选择要显示在输入区的模式。隐藏模式不会更改已有会话。"
                   TextWrapping="Wrap" Foreground="{DynamicResource PopupMutedForegroundBrush}" />
        <ItemsControl ItemsSource="{Binding Modes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionModeRow">
                    <Border Classes="settings-row" Padding="0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource PopupMutedForegroundBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="显示" IsChecked="{Binding ShowInComposer}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="新会话默认模式" FontSize="14" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PermissionModeRow">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="AI 审批模型" FontSize="14" />
        <CheckBox Content="使用当前会话的模型（随会话模型切换）" IsChecked="{Binding UseCurrentModel}" />
        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding ReviewerModel}"
                  IsEnabled="{Binding UseFixedModel}" PlaceholderText="选择独立的审批供应商与模型"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ApprovalModelChoice">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="AI 使用独立审核请求，可能产生额外用量。拒绝、超时或失败会转交用户，操作不会自动执行。"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PopupMutedForegroundBrush}" />
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" />
        <Button Content="保存权限设置" Command="{Binding SaveCommand}" Classes="settings-secondary"
                HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
