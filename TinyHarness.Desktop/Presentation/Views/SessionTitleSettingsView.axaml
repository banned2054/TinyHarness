<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TinyHarness.Desktop.ViewModels"
             x:Class="TinyHarness.Desktop.Presentation.Views.SessionTitleSettingsView"
             x:DataType="vm:SessionTitleSettingsViewModel">
    <StackPanel>
        <TextBlock Classes="settings-group-title" Text="会话自动命名" />
        <Border Classes="settings-group">
            <StackPanel>
                <Border Classes="settings-row" Classes.last="{Binding UseCurrentModel}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="settings-card-title" Text="命名使用当前模型" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCurrentModel, Mode=TwoWay}"
                                      AutomationProperties.Name="命名使用当前模型" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="settings-row last" IsVisible="{Binding UseFixedModel}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Classes="settings-card-title" Text="命名使用的模型" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Classes="dropdown" MinWidth="156" MaxWidth="300"
                                  ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  PlaceholderText="选择供应商 / 模型" HorizontalAlignment="Right"
                                  AutomationProperties.Name="命名使用的模型">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TitleModelChoice">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        <TextBlock Classes="settings-card-description" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="使用独立请求生成标题，可能产生额外用量。失败时保留首条输入摘要，后续发送时重试；与 AI 审批模型分别设置。" />
        <TextBlock Classes="settings-card-description" Text="{Binding Notice}" Margin="0,12,0,0" />
        <Button Content="重试" Command="{Binding SaveCommand}" Classes="settings-secondary"
                IsVisible="{Binding HasAutoSaveError}" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
