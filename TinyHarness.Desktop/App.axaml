<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TinyHarness.Desktop.App" RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/ScrollBars.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Markdown.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Typography.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/PopupMenus.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Conversation.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Tooling.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Sidebar.axaml" />
        <StyleInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Composer.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
                <ResourceInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/ThemeResources.axaml" />
                <ResourceInclude Source="avares://TinyHarness.Desktop/Presentation/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
