<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Trim for NativeAOT from the first slice onward. -->
		<PublishTrimmed>true</PublishTrimmed>
		<IsAotCompatible>true</IsAotCompatible>

		<!-- Required by the LibraryImport source generator used by the Windows
         credential-store P/Invoke; only generated interop code is unsafe. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- PLAN §21：模型调用统一经 Microsoft.Extensions.AI 的 IChatClient，底层保留
             OpenAI 官方 SDK。两个包都被 Core 直接使用：M.E.AI.OpenAI 提供
             ChatClient → IChatClient 适配，OpenAI 提供传输构造。离线 mock 与
             win-x64 NativeAOT 探针均已验证零 trim/AOT 警告。 -->
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
		<PackageReference Include="OpenAI" Version="2.14.0" />
	</ItemGroup>

</Project>
